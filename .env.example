# Development defaults to the accepted frontend prototype.
# Production always requires Supabase, regardless of this flag.
NEXT_PUBLIC_TALKINGSTAGE_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin used for confirmation and password recovery links.
TALKINGSTAGE_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (public, inlined at build: redeploy after changing). Empty hides
# the security check. Local/test always-pass key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local Supabase only (supabase/config.toml [auth.captcha]). Hosted projects keep the secret in
# the Supabase dashboard, never in Vercel. Always-pass test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=
# Set to 1 to enforce the Content-Security-Policy; empty sends it report-only (see fix.md F02).
# Read when next.config.ts headers are built: changing it needs a rebuild/redeploy, not just a restart.
TALKINGSTAGE_CSP_ENFORCE=
# Resend API key, used only if supabase/config.toml enables local SMTP. Hosted projects
# keep it in the Supabase dashboard SMTP settings, never in Vercel.
SMTP_PASSWORD=
# Optional localhost-only automatic login using the private saved hosted test account.
# Ignored outside development. Keep disabled for public deployments and regular auth tests.
TALKINGSTAGE_DEV_TEST_LOGIN=0
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server only; signs short-lived age-declaration and recovery cookies.
AUTH_FLOW_SECRET=
# Server only; trusted image operations and narrowly authorized reply processing.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Disabled until keys, selected model and private DB budgets are ready.
TALKINGSTAGE_AI_ENABLED=false
TALKINGSTAGE_AI_PROVIDER=anthropic
TALKINGSTAGE_AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Server-only Bachs setup. Start in sandbox; no payment is enabled by this template.
TALKINGSTAGE_PAYMENTS_ENABLED=false
BACHS_ENVIRONMENT=sandbox
BACHS_API_KEY=
BACHS_ORGANIZATION_ID=
BACHS_WEBHOOK_SECRET=
# Bachs callbacks require a public HTTPS TALKINGSTAGE_SITE_URL (localhost is rejected).
# Configure the matching private.bachs_configuration row and optional request policy
# using docs/bachs-payments.md after setting the merchant name and NGN limits.
