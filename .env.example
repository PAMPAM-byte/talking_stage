# Development defaults to the accepted frontend prototype.
# Production always requires Supabase, regardless of this flag.
NEXT_PUBLIC_TALKINGSTAGE_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin used for password recovery links. Disable Confirm Email in hosted Auth.
TALKINGSTAGE_SITE_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server only; signs short-lived age-declaration and recovery cookies.
AUTH_FLOW_SECRET=
# Server only; trusted image operations and narrowly authorized reply processing.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Disabled until keys, selected model and private DB budgets are ready.
TALKINGSTAGE_AI_ENABLED=false
TALKINGSTAGE_AI_PROVIDER=openai
TALKINGSTAGE_AI_MODEL=
OPENAI_API_KEY=
